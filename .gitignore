# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Design reference — the standalone HTML mockups the UI was rebuilt from. Kept
# locally for consultation only; `globals.css`, `ui.tsx` and `penal.ts` cite
# them by name in comments, but nothing imports them, so they are not part of
# the build.
lssd-wiki-modern.html
/design-reference/

# claude code local state (agents, skills and plans are machine-local tooling)
.claude/
# Windows marks downloaded files as `<name>:Zone.Identifier` (a colon, not a
# dot), so the leading `*` must be unbounded — `*.Zone.Identifier` matches
# nothing and silently lets these artifacts into the tree.
*Zone.Identifier
